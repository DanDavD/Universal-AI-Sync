# ── PayPal ────────────────────────────────────────────────────────────────────
# Get these from developer.paypal.com → My Apps & Credentials
PAYPAL_CLIENT_ID=your_client_id_here
PAYPAL_CLIENT_SECRET=your_client_secret_here

# "sandbox" for testing, "live" for production
PAYPAL_MODE=sandbox

# After running `npm run setup-paypal`, paste the IDs it prints here
PAYPAL_PRODUCT_ID=
PAYPAL_PLAN_ID=

# Webhook ID — create a webhook in PayPal dashboard pointing to /api/paypal/webhook
# Subscribe to: BILLING.SUBSCRIPTION.ACTIVATED, BILLING.SUBSCRIPTION.CANCELLED,
#               BILLING.SUBSCRIPTION.SUSPENDED, PAYMENT.SALE.COMPLETED
PAYPAL_WEBHOOK_ID=

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000

# Full public URL of this server (used for PayPal redirect URLs)
# e.g. https://your-domain.com  or  https://abc123.ngrok.io  for local testing
BASE_URL=http://localhost:3000

# ── Email (for sending license keys) ──────────────────────────────────────────
# Any SMTP provider works (Gmail, SendGrid, Mailgun, etc.)
# For Gmail: enable "App Passwords" and use that as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your_app_password_here
EMAIL_FROM="Universal AI Sync <your@email.com>"

# ── Subscription price (displayed on checkout page) ───────────────────────────
PRICE_DISPLAY=$9.99/month
